# ─── Model ──────────────────────────────────────────────────────────────────
# Leave ANTHROPIC_API_KEY unset to run in demo mode (canned streaming replies).
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-4-8
CHAT_MAX_TOKENS=8192

# ─── Product ────────────────────────────────────────────────────────────────
PORT=3000
FREE_DAILY_LIMIT=15

# ─── Billing ────────────────────────────────────────────────────────────────
# A Stripe Payment Link URL. When set, every "Upgrade" button points here.
# Configure the link's confirmation page to redirect to:
#   https://<your-domain>/success.html?session_id={CHECKOUT_SESSION_ID}
STRIPE_PAYMENT_LINK=
# Signing secret for the /api/stripe/webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Signs Pro cookies. Pin this in production or Pro sessions reset on restart.
APP_SECRET=
# How long one payment keeps Pro unlocked, in days.
PRO_DAYS=31
