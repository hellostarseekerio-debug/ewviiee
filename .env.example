# ─── Exchange ───────────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
PAPER_TRADING=true            # true = no real orders

# ─── On-chain / Market Data ─────────────────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key
COINGLASS_API_KEY=your_coinglass_api_key
GLASSNODE_API_KEY=your_glassnode_api_key
WHALEALERT_API_KEY=your_whalealert_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# ─── News / Sentiment ────────────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ETHTradingBot/1.0

# ─── Alerts ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ethbot
POSTGRES_USER=ethbot
POSTGRES_PASSWORD=changeme

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Economic Calendar ───────────────────────────────────────────────────────
TRADING_ECONOMICS_API_KEY=your_trading_economics_key

# ─── Bot Config ──────────────────────────────────────────────────────────────
SYMBOL=ETHUSDT
MAX_RISK_PCT=0.01             # 1 % per trade
MAX_DAILY_DRAWDOWN=0.03       # 3 %
MAX_TOTAL_DRAWDOWN=0.10       # 10 %
MAX_CONCURRENT_TRADES=3
ML_CONFIDENCE_THRESHOLD=0.72
LOG_LEVEL=INFO
