# Copy this file to .env and fill in the values you need.
# Every value here maps to a Settings field in app/core/config.py (prefix OAP_).

OAP_ENVIRONMENT=development
OAP_DATA_DIR=./data
OAP_CONFIG_DIR=./config

# --- Database -----------------------------------------------------------
OAP_DATABASE_BACKEND=sqlite
OAP_SQLITE_PATH=./data/office_automation.db
# OAP_DATABASE_BACKEND=postgresql
# OAP_POSTGRES_DSN=postgresql+psycopg2://user:password@localhost:5432/office_automation

# --- AI provider (switch without any code change) ------------------------
# One of: openai | anthropic | azure_openai | local
OAP_AI_PROVIDER=local

OAP_OPENAI_API_KEY=
OAP_OPENAI_MODEL=gpt-4o-mini

OAP_ANTHROPIC_API_KEY=
OAP_ANTHROPIC_MODEL=claude-sonnet-5

OAP_AZURE_OPENAI_API_KEY=
OAP_AZURE_OPENAI_ENDPOINT=
OAP_AZURE_OPENAI_DEPLOYMENT=
OAP_AZURE_OPENAI_API_VERSION=2024-06-01

OAP_LOCAL_LLM_BASE_URL=http://localhost:11434
OAP_LOCAL_LLM_MODEL=llama3

# --- OCR ------------------------------------------------------------------
OAP_OCR_PRIMARY_ENGINE=paddle
OAP_OCR_FALLBACK_ENGINE=tesseract
OAP_OCR_CONFIDENCE_THRESHOLD=0.75
OAP_OCR_MAX_RETRIES=2

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters and NOT the default below once
# OAP_ENVIRONMENT=production - the app refuses to start otherwise.
OAP_SECRET_KEY=change-me-in-production

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production (and for MFA / any encrypted-secret feature to work).
# Back this up somewhere safe - losing it makes encrypted data unrecoverable.
OAP_ENCRYPTION_KEY=

# JWT access token lifetime. Kept short deliberately; MFA-pending tokens
# have their own fixed 5-minute lifetime regardless of this value.
OAP_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Exact origin(s) a browser client is served from, as a JSON list. Never
# use ["*"] in production - it is rejected outright when
# OAP_ENVIRONMENT=production.
OAP_CORS_ALLOWED_ORIGINS=["http://localhost:8000"]

# The API binds to localhost only by default - put a TLS-terminating
# reverse proxy in front for real deployments (see docs/DEPLOYMENT.md).
OAP_API_HOST=127.0.0.1
OAP_API_PORT=8000
# Auto-reload is a development convenience only - never enable in production.
OAP_API_RELOAD=false

# Rate limits (slowapi syntax, e.g. "5/minute"). Applied per client IP.
OAP_RATE_LIMIT_LOGIN=5/minute
OAP_RATE_LIMIT_DEFAULT=120/minute

# Set to true ONLY when a reverse proxy (nginx/Caddy) is the sole way to
# reach this app - otherwise every request appears to come from the
# proxy's own address, and per-IP rate limiting/logging becomes one
# shared bucket for every user instead of per-client. OAP_TRUSTED_PROXY_HOSTS
# is an exact-match allowlist of addresses permitted to set
# X-Forwarded-For (default: only the proxy running on the same host).
OAP_TRUST_PROXY_HEADERS=false
OAP_TRUSTED_PROXY_HOSTS=127.0.0.1

# --- File upload safety -----------------------------------------------------
OAP_MAX_UPLOAD_SIZE_BYTES=26214400
OAP_ALLOWED_UPLOAD_EXTENSIONS=[".pdf", ".docx", ".png", ".jpg", ".jpeg", ".tiff", ".zip"]

# --- Import sources --------------------------------------------------------
OAP_DROPBOX_ROOT=
OAP_GOOGLE_DRIVE_ROOT=
OAP_ONEDRIVE_ROOT=
OAP_LOCAL_IMPORT_ROOT=./data/import
OAP_ARCHIVE_ROOT=./data/archive
OAP_EXPORT_ROOT=./data/export

# --- Plugins ------------------------------------------------------------------
OAP_ENABLED_PLUGINS=["housing_estate_poster"]

# --- Backups ------------------------------------------------------------------
OAP_BACKUP_DIR=./data/backups
OAP_BACKUP_RETENTION_DAYS=90
