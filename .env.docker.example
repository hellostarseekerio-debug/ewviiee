# Copy to .env before running `docker compose up` (docker-compose.yml
# reads this same file for both variable substitution and the api
# service's env_file). Fill in every value marked REQUIRED.
#
# Everything here maps to a Settings field in app/core/config.py
# (prefix OAP_) except the POSTGRES_* variables, which docker-compose.yml
# uses to configure the `db` service and to build OAP_POSTGRES_DSN.

OAP_ENVIRONMENT=production

# --- PostgreSQL (used by docker-compose.yml's `db` service) ----------------
# REQUIRED: set a real password - docker-compose.yml refuses to start the
# db service without one (see its ${POSTGRES_PASSWORD:?...} default).
POSTGRES_USER=oap
POSTGRES_PASSWORD=
POSTGRES_DB=office_automation

# --- Database ---------------------------------------------------------------
# docker-compose.yml overrides both of these to point at the `db` service
# regardless of what's set here - left in place only so the same .env file
# also works if you ever run the app outside Compose (e.g. `python -m
# app.api.main` directly against a different Postgres instance).
OAP_DATABASE_BACKEND=postgresql
OAP_POSTGRES_DSN=postgresql+psycopg2://oap:change-me@localhost:5432/office_automation

# --- AI provider (switch without any code change) ------------------------
# One of: openai | anthropic | azure_openai | local
# Leave as `local` unless your office has explicitly decided to use a
# cloud provider - see docs/PRIVACY.md. Even then, cloud AI stays blocked
# until an administrator enables it via Settings/`PUT /api/settings`.
OAP_AI_PROVIDER=local

OAP_OPENAI_API_KEY=
OAP_OPENAI_MODEL=gpt-4o-mini

OAP_ANTHROPIC_API_KEY=
OAP_ANTHROPIC_MODEL=claude-sonnet-5

OAP_AZURE_OPENAI_API_KEY=
OAP_AZURE_OPENAI_ENDPOINT=
OAP_AZURE_OPENAI_DEPLOYMENT=
OAP_AZURE_OPENAI_API_VERSION=2024-06-01

OAP_LOCAL_LLM_BASE_URL=http://localhost:11434
OAP_LOCAL_LLM_MODEL=llama3

# --- OCR ------------------------------------------------------------------
OAP_OCR_PRIMARY_ENGINE=paddle
OAP_OCR_FALLBACK_ENGINE=tesseract
OAP_OCR_CONFIDENCE_THRESHOLD=0.75
OAP_OCR_MAX_RETRIES=2

# --- Security ---------------------------------------------------------------
# REQUIRED: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters and not the placeholder below - the app
# refuses to start with OAP_ENVIRONMENT=production otherwise.
OAP_SECRET_KEY=change-me-in-production

# REQUIRED: generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up outside the container/host - losing it makes encrypted
# data (including any enrolled MFA secrets) permanently unrecoverable.
OAP_ENCRYPTION_KEY=

# TEMPORARY, OPTIONAL: set BOTH of these (then redeploy) to create or reset
# an admin account from an environment variable instead of running
# scripts/create_admin.py in a shell - for platforms with no shell access
# (e.g. Render's free tier). See scripts/bootstrap_admin_from_env.py and
# docs/RENDER_DEPLOYMENT.md step 8. Leave both blank normally.
# REMOVE BOTH again immediately after logging in once - leaving them set
# resets that account's password back to this value on every restart.
# OAP_BOOTSTRAP_ADMIN_USERNAME=
# OAP_BOOTSTRAP_ADMIN_PASSWORD=

OAP_ACCESS_TOKEN_EXPIRE_MINUTES=60

# REQUIRED: the exact origin(s) your browser client(s) are served from, as
# a JSON list, e.g. ["https://office-automation.example.gov.hk"]. Never
# ["*"] - rejected outright in production.
OAP_CORS_ALLOWED_ORIGINS=["https://office-automation.example.gov.hk"]

# docker-compose.yml overrides OAP_API_HOST to 0.0.0.0 regardless of what's
# set here (required for Docker's port publishing to reach the process
# inside the container) - the compose file itself only publishes that port
# to the host's loopback interface (127.0.0.1:8000:8000), so the API is
# still not directly reachable from the internet without a reverse proxy.
OAP_API_HOST=127.0.0.1
OAP_API_PORT=8000
OAP_API_RELOAD=false

OAP_RATE_LIMIT_LOGIN=5/minute
OAP_RATE_LIMIT_DEFAULT=120/minute

# Enabled by default for this Docker deployment, which assumes a reverse
# proxy (docs/DEPLOYMENT.md §5) is the only way to reach the published
# port - without this, per-IP rate limiting/logging would treat every
# request as coming from the proxy, becoming one shared bucket for every
# user. "*" trusts X-Forwarded-For from whatever directly connects to the
# container, which is safe specifically because nothing outside the host
# can reach it directly (the compose file only publishes to
# 127.0.0.1:8000) - if you instead expose this port more broadly, replace
# "*" with your proxy's actual address.
OAP_TRUST_PROXY_HEADERS=true
OAP_TRUSTED_PROXY_HOSTS=*

# --- File upload safety -----------------------------------------------------
OAP_MAX_UPLOAD_SIZE_BYTES=26214400
OAP_ALLOWED_UPLOAD_EXTENSIONS=[".pdf", ".docx", ".png", ".jpg", ".jpeg", ".tiff", ".zip"]

# --- Import sources --------------------------------------------------------
# Paths are inside the container - /app/data is the bind-mounted volume
# from docker-compose.yml (./data on the host). Leave the cloud-storage
# roots empty unless you have separately mounted them into the container.
OAP_DROPBOX_ROOT=
OAP_GOOGLE_DRIVE_ROOT=
OAP_ONEDRIVE_ROOT=
OAP_LOCAL_IMPORT_ROOT=/app/data/import
OAP_ARCHIVE_ROOT=/app/data/archive
OAP_EXPORT_ROOT=/app/data/export

# --- Plugins ------------------------------------------------------------------
OAP_ENABLED_PLUGINS=["housing_estate_poster"]

# --- Backups ------------------------------------------------------------------
OAP_BACKUP_DIR=/app/data/backups
OAP_BACKUP_RETENTION_DAYS=90
