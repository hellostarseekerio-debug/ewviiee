# Copy to .env.local for local development, or set as a build/runtime
# environment variable on Vercel/Render.
#
# The base URL of the FastAPI backend (app/api/main.py in the repo root).
# No trailing slash. Must be reachable from the browser (not just the
# server), since this is a client-side rendered SPA-style app that calls
# the API directly from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
