# --- The Queen Victoria — environment configuration ---
# Copy to .env and fill in. All values are optional for local development;
# the site runs fully without an API key (the concierge uses its built-in
# knowledge base) but set ANTHROPIC_API_KEY to enable the Claude-powered AI mode.

# Server
PORT=3000
NODE_ENV=development

# Public site URL — used for sitemap.xml, robots.txt and structured data.
SITE_URL=http://localhost:3000

# AI Concierge (Claude). Leave blank to use the local fallback responder.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL=claude-opus-4-8

# Optional: restrict CORS to a specific origin in production.
# CORS_ORIGIN=https://thequeenvictoriahk.com

# Optional: override the SQLite database location.
# DB_PATH=./data/queenvictoria.db
